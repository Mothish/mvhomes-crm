# Copy to /etc/mvhomes.env on the server (chmod 600) and fill in your values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Public IP and/or domain, comma separated (no spaces)
DJANGO_ALLOWED_HOSTS=your-domain.duckdns.org,203.0.113.10
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.duckdns.org
# Set to 1 only after HTTPS (certbot) is working
DJANGO_HTTPS=0
# 1 = show demo logins on the sign-in page (client demos only)
DEMO_MODE=1
